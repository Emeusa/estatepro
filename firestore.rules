rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if false;
    }

    match /agents/{agentId} {
      allow read: if isOwner(agentId) || isAdmin();
      allow create: if signedIn() && request.auth.uid == agentId;
      allow update: if isOwner(agentId) || isAdmin();
      allow delete: if false;
    }

    match /subscriptions/{agentId} {
      allow read: if isOwner(agentId) || isAdmin();
      allow write: if isAdmin();
    }

    match /listings/{listingId} {
      allow read: if resource.data.status == 'active' || isAdmin() ||
        (signedIn() && resource.data.agentId == request.auth.uid);
      allow create: if signedIn() &&
        request.resource.data.agentId == request.auth.uid;
      allow update: if isAdmin() ||
        (signedIn() &&
        resource.data.agentId == request.auth.uid &&
        request.resource.data.agentId == resource.data.agentId);
      allow delete: if isAdmin() ||
        (signedIn() && resource.data.agentId == request.auth.uid);
    }
  }
}
