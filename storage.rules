rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    function isAllowedImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isAllowedDocument() {
      return request.resource.contentType.matches('application/pdf') ||
        request.resource.contentType.matches('image/.*');
    }

    match /listing-images/{agentId}/{fileName} {
      allow read: if true;
      allow write: if signedIn() &&
        request.auth.uid == agentId &&
        isAllowedImage() &&
        request.resource.size < 5 * 1024 * 1024;
    }

    match /verification-documents/{agentId}/{fileName} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == agentId);
      allow write: if signedIn() &&
        request.auth.uid == agentId &&
        isAllowedDocument() &&
        request.resource.size < 8 * 1024 * 1024;
    }
  }
}
